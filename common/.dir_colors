# =============================================================================
# ~/.dir_colors — colors for ls output
# Works with: ls --color=auto (Linux) and gls --color=auto (macOS via coreutils)
# Apply: eval "$(dircolors ~/.dir_colors)" in .bashrc
#
# Attribute codes:
#   00=none  01=bold  04=underscore  05=blink  07=reverse  08=concealed
# Text color codes:
#   30=black  31=red  32=green  33=yellow  34=blue  35=magenta  36=cyan  37=white
# Background color codes:
#   40=black  41=red  42=green  43=yellow  44=blue  45=magenta  46=cyan  47=white
# =============================================================================

COLOR tty

OPTIONS -F -b -T 0

# terminal types
TERM linux
TERM console
TERM con132x25
TERM con132x30
TERM con132x43
TERM con132x60
TERM con80x25
TERM con80x28
TERM con80x30
TERM con80x43
TERM con80x50
TERM con80x60
TERM xterm
TERM xterm-256color
TERM xterm-color
TERM screen
TERM screen-256color
TERM tmux
TERM tmux-256color
TERM rxvt
TERM rxvt-unicode
TERM rxvt-unicode-256color
TERM vt100

EIGHTBIT 1

# =============================================================================
# file types
# =============================================================================

NORMAL  00                  # default
FILE    00                  # regular file
DIR     01;34               # directory — bold blue
LINK    01;36               # symbolic link — bold cyan
FIFO    40;33               # named pipe — yellow on black
SOCK    01;35               # socket — bold magenta
BLK     40;33;01            # block device — bold yellow on black
CHR     40;33;01            # character device — bold yellow on black
ORPHAN  01;31               # broken symlink — bold red
MISSING 01;31               # missing file pointed to by symlink
EXEC    01;32               # executable — bold green

# =============================================================================
# archives & compressed
# =============================================================================

.tar    01;31
.tgz    01;31
.tbz2   01;31
.txz    01;31
.arj    01;31
.taz    01;31
.lzh    01;31
.lzma   01;31
.zip    01;31
.z      01;31
.Z      01;31
.gz     01;31
.bz2    01;31
.xz     01;31
.zst    01;31
.7z     01;31
.rar    01;31
.deb    01;31
.rpm    01;31
.dmg    01;31
.iso    01;31
.img    01;31

